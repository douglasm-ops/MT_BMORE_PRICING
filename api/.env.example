# ── MaidThis Baltimore Pricing API ──────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Port the server listens on (default: 3000)
PORT=3000

# API key for write/admin endpoints (PATCH /api/prices)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your-secret-api-key-here

# Comma-separated list of allowed CORS origins (leave blank for *)
# ALLOWED_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com

# SQLite database path for quote logging (default: api/db/quotes.db)
# DB_PATH=./db/quotes.db
